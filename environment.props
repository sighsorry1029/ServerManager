<Project>
    <PropertyGroup>
        <ValheimGamePath Condition="'$(ValheimGamePath)' == '' And '$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimGamePath>
        <!-- Safe default: building the project must not mutate a live Valheim install.
             Override CopyOutputDLLPath explicitly when you intend to deploy. -->
        <CopyOutputDLLPath Condition="'$(CopyOutputDLLPath)' == ''">$(MSBuildThisFileDirectory)artifacts\local-build</CopyOutputDLLPath>
        <!--<CopyOutputDLLPath2>$(ValheimGamePath)\BepInEx\plugins</CopyOutputDLLPath2>-->
        <!--<CopyOutputDLLPath3>$(ValheimGamePath)\BepInEx\plugins</CopyOutputDLLPath3>-->
    </PropertyGroup>
</Project>
