    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
    <Target Name="GetAssemblyVersion" AfterTargets="Build">
        <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
            <Output TaskParameter="Assemblies" ItemName="Targets"/>
        </GetAssemblyIdentity>
        <ItemGroup>
            <AssemblyVersions Include="@(Targets->'%(Version)')"/>
        </ItemGroup>
        <Error Text="Failed to get Assembly Version." Condition="'%(AssemblyVersions.Identity)' == ''"/>
        <PropertyGroup>
            <AssemblyVersion>%(AssemblyVersions.Identity)</AssemblyVersion>
            <Major>$(AssemblyVersion.Split('.')[0])</Major>
            <Minor>$(AssemblyVersion.Split('.')[1])</Minor>
            <Patch>$(AssemblyVersion.Split('.')[2])</Patch>
            <PackageName>$(AssemblyName)_v$(Major).$(Minor).$(Patch)</PackageName>
            <PackageVersion>$(Major).$(Minor).$(Patch)</PackageVersion>
            <VersionString>$(Major).$(Minor).$(Patch)</VersionString>
            <PackageDir>$(ProjectDir)\Thunderstore\$(PackageName)</PackageDir>
            <NexusPackageDir>$(ProjectDir)\Nexus\$(PackageName)</NexusPackageDir>
        </PropertyGroup>
    </Target>
    <Target Name="CopyOutputDLL" AfterTargets="GetAssemblyVersion">
        <Error Text="DLL not found in target directory." Condition="!Exists('$(TargetDir)$(AssemblyName).dll')"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath)" OverwriteReadOnlyFiles="true"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath2)" OverwriteReadOnlyFiles="true" Condition="Exists('$(CopyOutputDLLPath2)')"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath3)" OverwriteReadOnlyFiles="true" Condition="Exists('$(CopyOutputDLLPath3)')"/>
    </Target>
    <Target Name="MakeThunderstorePackage" DependsOnTargets="GetAssemblyVersion" Condition=" ('$(Configuration)|$(Platform)' == 'Release|AnyCPU') And ('$(OS)' == 'Windows_NT') ">
        <Error Text="ServerManager.dll was not built before packaging." Condition="!Exists('$(TargetDir)$(AssemblyName).dll')"/>
        <Error Text="README.md not found in project directory; refusing to create an incomplete release package." Condition="!Exists('$(ProjectDir)README.md')"/>
        <Error Text="manifest.json not found in Thunderstore directory." Condition="!Exists('$(ProjectDir)\Thunderstore\manifest.json')"/>
        <Error Text="icon.png not found in Thunderstore directory. Please note that Thunderstore requires this image to be 256x256 in dimension" Condition="!Exists('$(ProjectDir)\Thunderstore\icon.png')"/>
        <Error Text="CHANGELOG.md not found in Thunderstore directory." Condition="!Exists('$(ProjectDir)\Thunderstore\CHANGELOG.md')"/>
        <Error Text="English.yml not found in translations directory." Condition="!Exists('$(ProjectDir)\translations\English.yml')"/>
        <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)UpdateManifest.ps1&quot; -manifestFile &quot;$(ProjectDir)Thunderstore\manifest.json&quot; -versionString &quot;$(PackageVersion)&quot;"/>
        <RemoveDir Directories="$(PackageDir)" Condition="Exists('$(PackageDir)')"/>
        <MakeDir Directories="$(PackageDir)"/>
        <ItemGroup>
            <PackageFiles Include="$(TargetDir)$(AssemblyName).dll"/>
            <PackageFiles Include="$(ProjectDir)\Thunderstore\CHANGELOG.md"/>
            <PackageFiles Include="$(ProjectDir)\Thunderstore\icon.png"/>
            <PackageFiles Include="$(ProjectDir)\Thunderstore\manifest.json"/>
            <PackageFiles Include="$(ProjectDir)\README.md"/>
        </ItemGroup>
        <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(PackageDir)"/>
        <Copy SourceFiles="$(ProjectDir)translations\English.yml" DestinationFiles="$(PackageDir)\ServerManager.English.yml"/>
        <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="Thunderstore\$(PackageName).zip" Overwrite="true"/>
        <RemoveDir Directories="$(PackageDir)"/>
    </Target>
    <Target Name="MakeNexusPackage" DependsOnTargets="GetAssemblyVersion" Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <Error Text="ServerManager.dll was not built before packaging." Condition="!Exists('$(TargetDir)$(AssemblyName).dll')"/>
        <MakeDir Directories="$(ProjectDir)\Nexus"/>
        <RemoveDir Directories="$(NexusPackageDir)" Condition="Exists('$(NexusPackageDir)')"/>
        <MakeDir Directories="$(NexusPackageDir)"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(NexusPackageDir)"/>
        <ZipDirectory SourceDirectory="$(NexusPackageDir)" DestinationFile="Nexus\$(PackageName).zip" Overwrite="true"/>
        <RemoveDir Directories="$(NexusPackageDir)"/>
    </Target>
    <Target Name="PackageRelease" AfterTargets="Build"
            DependsOnTargets="GetAssemblyVersion;MakeThunderstorePackage;MakeNexusPackage"
            Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU' And '$(DesignTimeBuild)' != 'true'"/>
    <!-- Deploy only the final bundled plugin after a successful Debug build.
         Ordinary builds and DeployToGame=false leave the game installation alone. -->
    <Target Name="DeployDebugToGame" AfterTargets="Build" DependsOnTargets="BundleServerManager"
            Condition="'$(Configuration)' == 'Debug' And '$(DeployToGame)' == 'true' And '$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <DeployToGamePath Condition="'$(DeployToGamePath)' == ''">$(BepInExPath)\plugins</DeployToGamePath>
        </PropertyGroup>
        <Error Text="Final ServerManager DLL is missing; game deployment was skipped." Condition="!Exists('$(TargetPath)')"/>
        <Error Text="BepInEx directory is missing; game deployment was skipped." Condition="!Exists('$(BepInExPath)')"/>
        <MakeDir Directories="$(DeployToGamePath)"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployToGamePath)" OverwriteReadOnlyFiles="true"/>
        <Message Importance="high" Text="Debug plugin deployed: $(DeployToGamePath)\$(TargetFileName)"/>
    </Target>
    <Target Name="ValidatePackConfiguration">
        <Error Text="Pack requires Configuration=Release and Platform=AnyCPU." Condition=" '$(Configuration)|$(Platform)' != 'Release|AnyCPU' "/>
    </Target>
    <Target Name="Pack" DependsOnTargets="ValidatePackConfiguration;Build;MakeThunderstorePackage;MakeNexusPackage"/>

